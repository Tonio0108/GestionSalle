<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.gestion.controller.ProfController"
      spacing="14">
    <padding>
        <Insets top="4" right="4" bottom="4" left="4"/>
    </padding>

    <Label text="Gestion des professeurs" styleClass="page-title"/>

    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnAjouter" text="Ajouter" onAction="#onAjouter" styleClass="btn-primary">
                <tooltip><Tooltip text="Ouvrir la fenêtre de création d'un professeur"/></tooltip>
            </Button>
            <Button fx:id="btnModifier" text="Modifier" onAction="#onModifier" styleClass="btn-secondary">
                <tooltip><Tooltip text="Modifier le professeur sélectionné (ou double-clic, ou clic droit)"/></tooltip>
            </Button>
            <Button fx:id="btnSupprimer" text="Supprimer" onAction="#onSupprimer" styleClass="btn-danger">
                <tooltip><Tooltip text="Supprimer les lignes sélectionnées (ou touche Suppr, ou clic droit)"/></tooltip>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Rechercher :" styleClass="form-label"/>
            <ComboBox fx:id="cmbCritere">
                <tooltip><Tooltip text="Critère de recherche : nom (filtre instantané) ou code exact"/></tooltip>
            </ComboBox>
            <TextField fx:id="txtRecherche" promptText="Tapez pour filtrer par nom..." prefWidth="220">
                <tooltip><Tooltip text="Appuyez sur Entrée pour lancer la recherche"/></tooltip>
            </TextField>
            <Button text="Rechercher" onAction="#onRechercher" styleClass="btn-primary"/>
            <Button text="Tout afficher" onAction="#onAfficherTout" styleClass="btn-ghost"/>
        </HBox>

        <TableView fx:id="tableProf" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Aucun professeur enregistré — cliquez sur « Ajouter » pour commencer"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colCode" text="Code" prefWidth="70" minWidth="60" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="200" minWidth="100"/>
                <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="200" minWidth="100"/>
                <TableColumn fx:id="colGrade" text="Grade" prefWidth="240" minWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <Separator/>
        <Label fx:id="lblStatus" styleClass="status-info" wrapText="true"/>
    </VBox>
</VBox>
