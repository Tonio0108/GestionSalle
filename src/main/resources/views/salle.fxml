<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.gestion.controller.SalleController"
      spacing="14">
    <padding>
        <Insets top="4" right="4" bottom="4" left="4"/>
    </padding>

    <Label text="Gestion des salles" styleClass="page-title"/>

    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnAjouter" text="Ajouter" onAction="#onAjouter" styleClass="btn-primary">
                <tooltip><Tooltip text="Ouvrir la fenêtre de création d'une salle"/></tooltip>
            </Button>
            <Button fx:id="btnModifier" text="Modifier" onAction="#onModifier" styleClass="btn-secondary">
                <tooltip><Tooltip text="Modifier la salle sélectionnée (ou double-clic, ou clic droit)"/></tooltip>
            </Button>
            <Button fx:id="btnSupprimer" text="Supprimer" onAction="#onSupprimer" styleClass="btn-danger">
                <tooltip><Tooltip text="Supprimer les lignes sélectionnées (ou touche Suppr, ou clic droit)"/></tooltip>
            </Button>
        </HBox>

        <TableView fx:id="tableSalle" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Aucune salle enregistrée — cliquez sur « Ajouter » pour commencer"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colCode" text="Code" prefWidth="90" minWidth="70" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDesignation" text="Désignation" prefWidth="500" minWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <Separator/>
        <Label fx:id="lblStatus" styleClass="status-info" wrapText="true"/>
    </VBox>
</VBox>
